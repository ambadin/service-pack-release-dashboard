# Shell/env generated by Copilot
# =============================================================
# Docker/Podman Environment Configuration
# Copy to .env and configure: cp .env.example .env
# =============================================================

# ----------------------------------------------------------
# Application Settings
# ----------------------------------------------------------
NODE_ENV=production
# Container-internal listen port (Express reads process.env.PORT || 4000).
# 8080 matches the platform's per-application container-port convention.
PORT=8080

# ----------------------------------------------------------
# TFS / Azure DevOps Taskboard integration (optional)
# If unset, the dashboard falls back to built-in mock task data.
# ----------------------------------------------------------
TFS_URL=
TFS_PAT=
TFS_PROJECT=
TFS_ITERATION=

# ----------------------------------------------------------
# Windchill document download integration (optional)
# ----------------------------------------------------------
WINDCHILL_DOC_URL=
WINDCHILL_USER=
WINDCHILL_PASSWORD=

# ----------------------------------------------------------
# Corporate CA certificate (only if the network intercepts TLS,
# e.g. Cisco Umbrella/ZScaler). See Section 6 of the containerization guide.
# Leave DB_DATA_PATH pointing at the folder that holds corporate-ca.crt.
# ----------------------------------------------------------
DB_DATA_PATH=../data

# ----------------------------------------------------------
# Registry / image tag (Artifactory or local Podman registry)
# ----------------------------------------------------------
# IMAGE_REGISTRY=dl-innersource-docker-local.artifactory-ehv.ta.philips.com/dxr-apps/service-pack-release-dashboard
IMAGE_TAG=latest

# ----------------------------------------------------------
# Public/private port mapping for this app slot (set by the platform admin —
# see PER-PORT-APPLICATION-PLATFORM-ARCHITECTURE.md Section 9). Used only by
# docker-compose.standalone.yml for local testing; production deployment
# publishes to 127.0.0.1:<private-host-port> behind host nginx, not 0.0.0.0.
# ----------------------------------------------------------
HOST_PORT=8080
