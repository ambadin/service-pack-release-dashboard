# Shell/env generated by Copilot
# =============================================================
# Service Pack Release Dashboard — Runtime Application Configuration
# Variable names only — no real values belong in source control.
#
# Local smoke testing: copy to docker/.env (git-ignored) and fill in values,
# or leave blank to run with mock TFS data / the bundled SP Guideline PDF.
#
# Production (Linux/Podman server): a path-only .env may be transferred
# alongside the image tar, but never put credentials in the image or tar.
# Install the file with restricted permissions and use podman --env-file;
# see docker/README-deploy.md for the exact commands.
# =============================================================

# ----------------------------------------------------------
# TFS / Azure DevOps Taskboard integration
# Leave all four blank to fall back to built-in mock task data.
# ----------------------------------------------------------
TFS_URL=
TFS_PROJECT=
TFS_PAT=
TFS_ITERATION=

# ----------------------------------------------------------
# Optional hardening settings — see docker/README-deploy.md for rationale
# ----------------------------------------------------------
# Comma-separated browser origins allowed to call this API cross-origin.
# Leave blank (recommended) to disable cross-origin access entirely — the
# SPA and this API are served same-origin through host nginx.
ALLOWED_ORIGINS=

# ----------------------------------------------------------
# Planning workbook source of truth — see docker/README-deploy.md
# "Planning workbook source" for the Linux CIFS-mount requirement.
# Leave blank to serve the bundled snapshot shipped in the repo.
#
# Native Windows execution (npm run server, not containerized) can point
# directly at the UNC path:
#   SP_PLANNING_XLSX_PATH=\\ingbtcpic1vwsfs.code1.emi.philips.com\Bangalore3\Projects\DXR\FSA\Service pack planning sheet\service-pack-planning.xlsx
#
# Containerized (Podman/Docker, on any host OS): the container's Linux
# userspace cannot resolve a Windows UNC path directly. Mount the share via
# the host's CIFS client to a POSIX path, bind-mount that into the
# container, and point this variable at the IN-CONTAINER mount path, e.g.:
#   SP_PLANNING_XLSX_PATH=/mnt/sp-planning/service-pack-planning.xlsx
# ----------------------------------------------------------
SP_PLANNING_XLSX_PATH=

# ----------------------------------------------------------
# SP Guideline PDF source of truth — same live-share/CIFS-mount pattern as
# SP_PLANNING_XLSX_PATH above. Leave blank to serve the bundled PDF shipped
# in public/.
#   SP_GUIDELINE_PDF_PATH=\\ingbtcpic1vwsfs.code1.emi.philips.com\Bangalore3\Projects\DXR\FSA\Service pack planning sheet\2009001390 Service Pack Guideline_en 1.pdf
# ----------------------------------------------------------
SP_GUIDELINE_PDF_PATH=

# ----------------------------------------------------------
# IB System Release Versions workbook (IB System Versions tab) - same
# live-share/CIFS-mount pattern. Leave blank to serve the bundled copy.
#   IB_SYSTEM_VERSIONS_XLSX_PATH=/mnt/bangalore3/Projects/DXR/FSA/Service pack planning sheet/IB System Release Versions.xlsx
# ----------------------------------------------------------
IB_SYSTEM_VERSIONS_XLSX_PATH=
