# Dockerfile generated by Copilot
# =============================================================
# Service Pack Release Dashboard — Container Image
# Vite/React SPA (dist/) served by a single Express process that also
# proxies TFS/Azure DevOps + Windchill requests (server.js).
# Buildable and runnable with either Podman or Docker (OCI-compliant).
# =============================================================

# ---------- Stage 1: build the Vite SPA ----------
FROM node:22-alpine AS builder

WORKDIR /app

# Install with dev deps (vite, @vitejs/plugin-react, typescript) needed only for the build
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

# ---------- Stage 2: slim production runtime ----------
FROM node:22-alpine AS runtime

LABEL org.opencontainers.image.title="Service Pack Release Dashboard" \
      org.opencontainers.image.description="Service pack release planning dashboard (Vite/React SPA + Express API/TFS-Windchill proxy)" \
      org.opencontainers.image.vendor="Philips" \
      org.opencontainers.image.source="https://github.com/ambadin/service-pack-release-dashboard"

# libc6-compat: glibc shims some native npm packages expect on Alpine.
# ca-certificates: needed for outbound HTTPS calls (axios/httpntlm to TFS/Windchill).
RUN apk add --no-cache libc6-compat ca-certificates

WORKDIR /app

# Corporate CA handling: NODE_EXTRA_CA_CERTS is declared here but the
# certificate is NEVER baked into the image (see docker/README-deploy.md
# "Corporate CA handling" for the required operator decision: mount it
# read-only at this exact path, or remove this ENV line if the deployment
# network path does not intercept TLS).
ENV NODE_ENV=production \
    NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/corporate-ca.crt \
    HOSTNAME=0.0.0.0 \
    PORT=8080

# Production-only install — dotenv/express/axios/cors/httpntlm are runtime dependencies
# (react/react-dom/react-router-dom/typescript are devDependencies, only used by the
# Vite build in the builder stage, and are never installed here).
# Cleanup removes npm's root-owned cache/log remnants left behind before USER node runs.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf /root/.npm /tmp/*

COPY server.js ./
# Read directly from disk by the /api/*-xlsx routes (not part of the Vite bundle)
COPY service-pack-planning.xlsx ib-system-release-versions.xlsx ./
# Built SPA + files copied from public/ (index.html, service-pack-planning.csv, PDF guideline)
COPY --from=builder /app/dist ./dist

# Run as the non-root 'node' user baked into the base image (rootless-Podman friendly)
RUN chown -R node:node /app
USER node

EXPOSE ${PORT}

# Dependency-free healthcheck (no curl/wget in alpine) — matches the platform's
# expected health path (see PER-PORT-APPLICATION-PLATFORM-ARCHITECTURE.md, health.path).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||8080)+'/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "server.js"]
